# Copy file ini ke .env dan isi nilai-nya

# Database PostgreSQL — dapatkan dari Neon (https://neon.tech) atau Vercel Storage
# Contoh format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# API key Claude AI — dapatkan di https://console.anthropic.com
# Daftar gratis, lalu buat API key di tab "API Keys"
ANTHROPIC_API_KEY="sk-ant-xxxxx"

# Model Claude (default sudah paling bagus)
CLAUDE_MODEL="claude-sonnet-4-5"
