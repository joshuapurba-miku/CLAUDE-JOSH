# Copy this file to .env dan isi nilai-nya

# Database SQLite lokal (default sudah oke)
DATABASE_URL="file:./dev.db"

# API key Claude AI — dapatkan di https://console.anthropic.com
# Daftar gratis, lalu buat API key di tab "API Keys"
ANTHROPIC_API_KEY="sk-ant-xxxxx"

# Model Claude (default sudah paling bagus)
CLAUDE_MODEL="claude-sonnet-4-5"
