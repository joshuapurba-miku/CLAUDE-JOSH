# Salin file ini menjadi .env lalu isi nilainya.

# Token dari dashboard Fonnte (https://md.fonnte.com -> menu Device).
# Biarkan kosong untuk mode uji (pesan hanya tampil di log, tidak terkirim).
FONNTE_TOKEN=

# Kata kunci rahasia untuk URL webhook, mis. webhook/rahasia123
# Biarkan kosong jika tidak dipakai.
WEBHOOK_SECRET=

# Port server
PORT=3000

# Lokasi file data (opsional)
# DATA_FILE=./data.json
